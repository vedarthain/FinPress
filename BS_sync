#!/bin/bash
# ==============================================================================
# BS_sync: 1-Click Business Standard Session Sync & GitHub Actions Pipeline Trigger
# Can be run from any terminal directory on macOS.
# ==============================================================================

WORKSPACE_DIR="/Users/debasissahoo/Documents/NewsAPI"

echo "===================================================================="
echo "⚡ FINPRESS: BUSINESS STANDARD SESSION SYNC & PIPELINE TRIGGER"
echo "===================================================================="

cd "$WORKSPACE_DIR" || exit 1

# 1. Run Playwright login capture with persistent profile
if [ -f "$WORKSPACE_DIR/venv/bin/python" ]; then
    "$WORKSPACE_DIR/venv/bin/python" "$WORKSPACE_DIR/bs_login_setup.py"
else
    python3 "$WORKSPACE_DIR/bs_login_setup.py"
fi

# 2. Trigger GitHub Actions workflow
echo "🚀 Dispatching GitHub Actions extraction workflow..."
gh workflow run 2_fetch_business_standard.yml --repo vedarthain/FinPress 2>/dev/null || true

echo "✨ All done! Track live run: https://github.com/vedarthain/FinPress/actions"
echo "✨ Live Terminal: https://finpress.deb5045ai.workers.dev"
echo "===================================================================="
